{
  "schemaVersion": 1,
  "id": "lowdurabilityswitcher",
  "version": "${version}",

  "name": "Low Durability Switcher",
  "description": "This mod saves you from unfortunate tool breakage by switching the slot to another",
  "authors": [
    "Fanya"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/low-durability-switcher",
    "sources": "https://github.com/FanyaOff/Low-Durability-Switcher"
  },

  "license": "CC0-1.0",
  "icon": "assets/lowdurabilityswitcher/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.fanya.lowdurabilityswitcher.LowDurabilitySwitcher"
    ],
    "modmenu": [
      "net.fanya.lowdurabilityswitcher.integration.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "cloth-config": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
